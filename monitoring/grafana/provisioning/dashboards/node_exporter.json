          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "rate(node_network_transmit_bytes_total{device!~\"lo|docker.*|veth.*\"}[2m]) / 1024",
          "legendFormat": "Tx (Upload) - {{device}}",
          "range": true,
          "refId": "B"
        }
